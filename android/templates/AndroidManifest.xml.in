<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.dshremote.app"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION_NAME@">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 把 APK 交给系统安装器；首次使用会引导去开「安装未知应用」 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 首次配置时扫二维码；没给权限也能手填地址 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Android 11+ 包可见性：要判断微信在不在，才能只在装了微信时显示「发送到微信」 -->
    <queries>
        <package android:name="com.tencent.mm" />
    </queries>


    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 微信/QQ/文件管理器「分享」直接进 App，自动附到对话框 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 配对链接：站点是运行时配置的，没法按 host 过滤，就按 /__pair 路径认。
                 手机相机扫到 https://任意域名/__pair?code=… 点开就能直接进 App 并自动配好。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:pathPrefix="/__pair" />
            </intent-filter>
            <!-- 插件 / 脚本传配置的深链：dshremote://setup?host=…&code=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dshremote" />
            </intent-filter>
        </activity>

        <!-- 扫码页：独立的 Activity 才能干净地管相机生命周期；不导出 -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <provider
            android:name=".PreviewProvider"
            android:authorities="dev.dshremote.app.previews"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
